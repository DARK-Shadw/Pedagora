# Supabase
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google AI (Gemini)
GOOGLE_API_KEY=your-google-api-key

# Groq (optional — falls back to Gemini if empty)
GROQ_API_KEY=

# Pollinations (OpenAI-compatible, recommended for all stages)
POLLINATIONS_API_KEY=your-pollinations-pk-key

# Per-stage LLM models (optional — defaults shown)
# DECOMPOSE_MODEL=pollinations:qwen-coder
# EXTRACT_MODEL=pollinations:qwen-coder
# SYNTHESIZE_MODEL=pollinations:qwen-coder

# Search APIs
TAVILY_API_KEY=your-tavily-api-key
SERPER_API_KEY=your-serper-api-key
GITHUB_TOKEN=your-github-personal-access-token

# Frontend
FRONTEND_URL=http://localhost:3000
